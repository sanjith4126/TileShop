# ── Environment variables template ──
# Copy to .env for local dev, or set these on your host for production.

# Production: MUST be False. Local dev: True.
DEBUG=False

# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated domains, e.g. yourname.pythonanywhere.com,www.example.com
ALLOWED_HOSTS=

# Only for the AI Room Visualizer (requires Gemini billing enabled)
GEMINI_API_KEY=
