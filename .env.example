# ── Environment variables template ──
# Copy to .env for local development, or fill in on the server (see DEPLOY.md).
# Names only: never put real keys or passwords in this file. An empty value
# means "use the default".

# ── Required in production ───────────────────────────────
# False in production (the default). True only on your own computer.
DEBUG=
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated, e.g. yourname.pythonanywhere.com,www.example.com
ALLOWED_HOSTS=
# Public address without a trailing slash, e.g. https://yourname.pythonanywhere.com
# Used for canonical links, the sitemap, structured data and link previews.
SITE_URL=

# ── Recommended ──────────────────────────────────────────
# Admin address instead of admin/, e.g. manage-7f3k/
ADMIN_URL=

# ── Email alerts for new orders and quote requests (optional) ──
# Nothing is emailed without EMAIL_HOST; everything is still saved in the admin.
EMAIL_HOST=
# Default 587
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Default True (STARTTLS). Set EMAIL_USE_SSL=True instead for port 465.
EMAIL_USE_TLS=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=
# Where new orders and quote requests are announced
SHOP_NOTIFICATION_EMAIL=

# ── Search engines and analytics (optional) ──────────────
# Only the content="..." value of each verification meta tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# ga4 (ANALYTICS_ID=G-XXXXXXX) or plausible (ANALYTICS_ID=your domain).
# Nothing loads unless both are set.
ANALYTICS_PROVIDER=
ANALYTICS_ID=

# ── Shop (optional) ──────────────────────────────────────
# Default False. True only once the stock numbers in the admin are real:
# carts are then limited to the stock and orders reduce it.
ENFORCE_STOCK_LIMITS=

# ── AI Room Visualizer (optional, needs Gemini billing) ──
GEMINI_API_KEY=
# AI images per visitor per window in seconds. Defaults 5 and 3600.
VISUALIZER_RATE_LIMIT=
VISUALIZER_RATE_WINDOW=
